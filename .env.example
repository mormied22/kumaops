# Copy to .env. Never commit the real file. Environment values override this file.
KUMA_URL=https://kuma.example.com
KUMA_USERNAME=
KUMA_PASSWORD=
# Optional one-time six-digit code. Use a fresh unused code for EVERY invocation.
# Kuma rejects replaying a code in another login. Use --two-factor for hidden input.
KUMA_TOTP_CODE=
# Full Discord webhook; obtain your own URL. No actual token is shipped.
DISCORD_WEBHOOK_URL=
